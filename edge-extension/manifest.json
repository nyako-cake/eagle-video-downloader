{
  "manifest_version": 3,
  "name": "Eagle 视频下载助手（X / Twitter）",
  "version": "1.0.0",
  "description": "在 X（Twitter）的视频与动图下方添加按钮，一键把链接推送到 Eagle 视频下载器自动下载。",
  "minimum_chrome_version": "109",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:43110/*",
    "http://127.0.0.1:41595/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*",
        "https://sankaku.app/*",
        "https://*.sankaku.app/*",
        "https://*.sankakucomplex.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Eagle 视频下载助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
